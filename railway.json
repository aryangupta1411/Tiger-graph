{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/Dockerfile",
      "/.dockerignore",
      "/railway.json",
      "/requirements-ui.txt",
      "/.streamlit/**",
      "/ui/**",
      "/ops/**",
      "/rag/**",
      "/cases/**",
      "/runs/live-final-2/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/_stcore/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
