# Copy to .env (git-ignored). Keys from contracts/interfaces.md §D; everything else has a default.

# --- TigerGraph Savanna (PLAN §3.1, §3.6) ---------------------------------------------
TG_HOST=https://<workspace-id>.i.tgcloud.io   # Savanna workspace URL; contains "tgcloud" so pyTigerGraph picks port 443
TG_GRAPHNAME=FraudGraph
# Savanna → Database Secrets → Create Secret (value is shown once at creation — paste it below, nothing else on the line)
TG_SECRET=
TG_QUERY_TIMEOUT_MS=120000                     # GSQL-TIMEOUT injected by mcp/tg_mcp_launcher.py and ops/ensure_awake.py
TG_RESUME_MAX_WAIT_S=240                       # ensure_awake() backoff budget on 502/503 while the workspace resumes
TG_LOAD_TIMEOUT_MS=600000                      # GSQL-TIMEOUT for runLoadingJobWithFile (graph/load_all.py, rag/load_vectors.py)

# tigergraph-mcp 1.0.3 server-side tool lists (names, never `--blocked-tools destructive`)
TG_ALLOWED_TOOLS=run_installed_query,get_query_description,get_query_metadata,is_query_installed,get_neighbors,get_node,get_nodes,get_vertex_count,get_edge_count,get_vector_index_status,list_vector_attributes,discover_tools,get_tool_info,add_node,add_nodes,add_edge,add_edges
TG_BLOCKED_TOOLS=gsql,run_query,install_query,drop_query,drop_graph,clear_graph_data,delete_node,delete_nodes,delete_edge,delete_edges,update_schema,drop_vector_attribute,upsert_vectors,load_vectors_from_csv,load_vectors_from_json,add_vector_attribute,generate_gsql,generate_cypher,authenticate
TG_LOG_TOOL_CALLS=1
TG_HTTP_VALIDATE_TIMEOUT=30

# --- LLM and embeddings ----------------------------------------------------------------
# LLM_BACKEND=cli is the DEFAULT and needs NO API key: claude-agent-sdk drives the Claude Code CLI it
# bundles, which authenticates with your Claude subscription (quota, not API credit). It serves the
# agent ONLY our typed read queries (in-process SDK MCP server), with every built-in tool off and
# setting_sources=[] so your ~/.claude settings and CLAUDE.md never reach the run.
#   cli   -> claude-agent-sdk (free with a Claude subscription; no ANTHROPIC_API_KEY)
#   api   -> anthropic 1.7.0 (beta.messages.parse / tool_runner); ONLY then is ANTHROPIC_API_KEY required
#   mock  -> agent/fake_anthropic.FakeAnthropic (offline fixtures)
# Empty = cli, except under RUN_MODE=mock where it means mock. LLM_BACKEND=cli with RUN_MODE=mock is
# the useful split: the real model over DuckDB-backed facts, no graph and no keys.
LLM_BACKEND=                                   # cli | api | mock   (empty = cli; mock under RUN_MODE=mock)
# ANTHROPIC_API_KEY: ONLY needed when LLM_BACKEND=api.
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5                          # the model of record: the promoted run in cases/ used claude-sonnet-5 (cases/MANIFEST.md)
# SAR_MODEL: model for the SAR narrative draft (P8); empty = MODEL (no inline comment - dotenv trap below).
SAR_MODEL=
# Embeddings: EMBED_BACKEND=local is the DEFAULT and needs NO API key and NO network at run time.
#   local  -> sentence-transformers on this machine. One-off model download to ~/.cache/huggingface:
#             BAAI/bge-large-en-v1.5 (1024-d, MIT, 1.34 GB, the default) or the lighter
#             BAAI/bge-small-en-v1.5 (384-d, MIT, 133 MB) -> then also set EMBED_DIM=384.
#             EMBED_DIM is rendered into graph/schema_change_vectors.gsql, so 384 needs no .gsql edit.
#   voyage -> the paid Voyage API; only then is VOYAGE_API_KEY required.
EMBED_BACKEND=local                            # local | voyage   (local = free, no key)
EMBED_MODEL=BAAI/bge-large-en-v1.5             # local: HuggingFace id | voyage: voyage-4-lite
EMBED_DIM=1024                                 # bge-large / voyage-4-lite = 1024; bge-small = 384
EMBED_BATCH=32                                 # texts per forward pass (local backend)
EMBED_TRUST_REMOTE_CODE=1                      # 0 blocks HuggingFace custom model code (neither BGE model needs it)
# NOTE: python-dotenv keeps a trailing "# ..." as the VALUE of an EMPTY key, so the next two carry no
# inline comment. EMBED_DEVICE: empty = auto (mps on Apple Silicon, cuda, else cpu); or cpu/mps/cuda.
EMBED_DEVICE=
# VOYAGE_API_KEY: ONLY needed when EMBED_BACKEND=voyage.
VOYAGE_API_KEY=

# --- Run mode --------------------------------------------------------------------------
RUN_MODE=mock                                  # live | mock  (mock: no graph, no API keys; fixtures + recorded traces)
RUNS_DIR=runs
HHGOA_DB=data/hhgoa.duckdb                     # full DuckDB (ETL, rag.closedcase_embed_text, engine.facts_from_etl)
HHGOA_README=data/raw/README.md                # dataset README (Fraud Policy + patterns) that rag.chunk reads; copied there on day 1
ENGINE_DATA_DIR=data                           # engine/config.py: holds hhgoa.duckdb and models/isotonic.json (the scorer of record)
ENGINE_FACTS_DB=data/hhgoa_engine.duckdb       # facts DuckDB built by `make facts` (engine.facts_from_etl); engine.run_cases / replay / RUN_MODE=mock read it
VALIDATOR_DB=data/ids.duckdb                   # id-only DuckDB for the validator in CI (ops/export_id_tables.py; tables + views txc/card_feat/customer_feat/cc)
APPROVALS_DB=ui/approvals.sqlite

# --- keep-alive (ops/keep_alive.py) ---------------------------------------------------
KEEP_ALIVE_INTERVAL_S=180
KEEP_ALIVE_QUERY=prior_cases_for_customer
KEEP_ALIVE_PARAMS={"cu": "C13487", "as_of": "2016-12-31 23:59:59"}
